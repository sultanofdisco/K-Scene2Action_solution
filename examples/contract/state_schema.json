  "required": [
    "bindings",
    "episode_id",
    "request_id",
    "observed_at",
    "rgb_stamp",
    "depth_stamp",
    "capabilities",
    "facts"
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
