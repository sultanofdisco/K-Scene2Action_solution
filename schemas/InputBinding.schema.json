{
  "$defs": {
    "ImageRef": {
      "additionalProperties": false,
      "description": "Opaque asset reference; SHA-256 covers encoded file bytes, not pixels.",
      "properties": {
        "asset_id": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Asset Id",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "width": {
          "exclusiveMinimum": 0,
          "title": "Width",
          "type": "integer"
        },
        "height": {
          "exclusiveMinimum": 0,
          "title": "Height",
          "type": "integer"
        }
      },
      "required": [
        "asset_id",
        "sha256",
        "width",
        "height"
      ],
      "title": "ImageRef",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "request_id": {
      "minLength": 1,
      "pattern": "\\S",
      "title": "Request Id",
      "type": "string"
    },
    "command_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Command Sha256",
      "type": "string"
    },
    "environment_version": {
      "minLength": 1,
      "pattern": "\\S",
      "title": "Environment Version",
      "type": "string"
    },
    "source_image": {
      "$ref": "#/$defs/ImageRef"
    },
    "inspected_image": {
      "$ref": "#/$defs/ImageRef"
    },
    "preprocessing_version": {
      "minLength": 1,
      "pattern": "\\S",
      "title": "Preprocessing Version",
      "type": "string"
    }
  },
  "required": [
    "request_id",
    "command_sha256",
    "environment_version",
    "source_image",
    "inspected_image",
    "preprocessing_version"
  ],
  "title": "InputBinding",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
